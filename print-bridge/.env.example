# Shared secret — must match PRINT_BRIDGE_SECRET on the Cloudflare worker
PRINT_BRIDGE_SECRET=change-me-to-a-long-random-string

# Listen address (default binds localhost only; use 0.0.0.0 behind a tunnel)
PRINT_BRIDGE_HOST=127.0.0.1
PRINT_BRIDGE_PORT=8787

# Exact CUPS queue name from `lpstat -p -d` on the Mac Mini
PRINTER_NAME=

# dry-run | print — dry-run writes HTML under .tmp/ and does not call lp
PRINT_MODE=dry-run
