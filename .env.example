NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (do not expose client-side)
SUPABASE_SERVICE_ROLE_KEY=

# Database migrations (scripts/apply-migration-*.mjs)
# Direct host db.<ref>.supabase.co is IPv6-only and often fails with ENOTFOUND on home/office networks.
# Prefer the Session pooler URI from Supabase → Project Settings → Database → Connect:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Or set SUPABASE_DB_PASSWORD (+ optional SUPABASE_REGION, e.g. eu-west-2).
SUPABASE_DB_PASSWORD=
# DATABASE_URL=
# SUPABASE_REGION=eu-west-2

# Used to generate absolute QR URLs (decide real domain before Phase 4)
APP_BASE_URL=http://localhost:3000

# Phase 4 (printing)
PRINT_BRIDGE_URL=
PRINT_BRIDGE_SECRET=

# Phase 5 (Mailchimp)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
# Set to true to queue events without calling Mailchimp API (local dev default when keys missing)
MAILCHIMP_OUTBOX_ONLY=

# Shopify pricing sync (HIL-52) — Dev Dashboard app credentials
SHOPIFY_STORE_DOMAIN=hildas-houseplants.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: dedicated webhook HMAC secret (defaults to SHOPIFY_CLIENT_SECRET)
SHOPIFY_WEBHOOK_SECRET=

# Acuity booking → incomplete check-in (HIL-94)
# Integrations → API → view credentials (User ID + API Key)
ACUITY_USER_ID=
ACUITY_API_KEY=
# Webhook URL (Acuity Integrations → Webhooks):
#   POST https://<your-app>/api/webhooks/acuity
# Subscribe to appointment scheduled / “scheduled” events.

# Daily cron: Authorization: Bearer <secret>
#   GET /api/cron/shopify-pricing
#   GET /api/cron/mailchimp-outbox
CRON_SECRET=

